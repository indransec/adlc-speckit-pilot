# Copy to .env. Without OPENROUTER_API_KEY the agents run in deterministic mock mode.
OPENROUTER_API_KEY=
APP_ENV=dev                                   # deploy/environments/<APP_ENV>.yaml
APPROVAL_TOKEN_SECRET=change-me-to-a-long-random-secret
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006
API_URL=http://localhost:8000                 # used by the Streamlit front end
# DATA_DIR=./data                             # SQLite, object store, FAISS index
# MOCK_LLM_LATENCY_MS=0                       # simulate model latency in mock mode
# PHOENIX_PROJECT=travel-claims-assistant          # Phoenix project the spans (and costs) land in
