{
 "uid": "adlc-sim",
 "title": "ADLC simulation - hypercare",
 "refresh": "5s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "type": "stat",
   "title": "sim day",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "expr": "adlc_sim_day",
     "refId": "A"
    }
   ],
   "datasource": {
    "uid": "prometheus"
   }
  },
  {
   "type": "stat",
   "title": "runtime kill switch",
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
