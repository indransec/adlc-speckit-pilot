  <diagram id="p3" name="3 · Gate subgraph (same for every gate)">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="p3-0" />
        <mxCell id="p3-1" parent="p3-0" />
        <mxCell id="p3-c1" value="&lt;b style='font-size:22px'&gt;Gate subgraph — the pattern every gate G0–G7 uses&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Per-gate differences come from the gate profile: which Claude tasks run, which human inputs are awaited, which checks apply.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="10" width="2300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3-c2" value="enter Gn" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;" vertex="1" parent="p3-1">
          <mxGeometry x="40" y="220" width="120" height="60" as="geometry" />
