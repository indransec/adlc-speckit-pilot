        <mxCell id="p1-c62" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1" source="p1-c26" target="p1-c32">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c63" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1" source="p1-c32" target="p1-c38">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c64" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1" source="p1-c38" target="p1-c44">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c65" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1" source="p1-c44" target="p1-c50">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c66" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="p1-1" source="p1-c50" target="p1-c56">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c67" value="① run /speckit-* task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="p1-1" source="p1-c20" target="p1-c21">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c68" value="② draft as claude" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="p1-1" source="p1-c21" target="p1-c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c69" value="③ read status / checks (read-only client)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="p1-1" source="p1-c20" target="p1-c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c70" value="④ sign in UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.95;exitY=1;entryX=0.95;entryY=0;" edge="1" parent="p1-1" source="p1-c19" target="p1-c22">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c71" value="⑤ ledger event → relay → resume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="p1-1" source="p1-c22" target="p1-c20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c72" value="reject / drift → rework at the gate that froze the artifact" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="p1-1" source="p1-c38" target="p1-c26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c73" value="improve → new intake (next release)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="p1-1" source="p1-c59" target="p1-c17">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c74" value="Intake card&lt;br&gt;(Jira/ADO)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="p1-1">
          <mxGeometry x="100" y="78" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p1-c75" value="start thread" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="p1-1" source="p1-c74" target="p1-c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1-c76" value="&lt;b style='font-size:13px'&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color='#d6b656'&gt;■&lt;/font&gt; People decide (UI, PR review)&lt;br&gt;&lt;font color='#9673a6'&gt;■&lt;/font&gt; LangGraph flow: sequences, waits, retries, notifies; &lt;b&gt;no authority&lt;/b&gt;&lt;br&gt;&lt;font color='#82b366'&gt;■&lt;/font&gt; Claude Code + Spec Kit: writes specs, plans, code, briefs on a branch&lt;br&gt;&lt;font color='#b85450'&gt;■&lt;/font&gt; ADLC engine: checks, roles, signatures, ledger, drift blocking&lt;br&gt;&lt;font color='#666666'&gt;■&lt;/font&gt; Delivery and runtime (CI/CD, product agents, observability)&lt;br&gt;⏸ = LangGraph interrupt() waiting for people · dashed = event / loop&lt;br&gt;①–⑤ on G1 show the interaction pattern used at every gate" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p1-1">
          <mxGeometry x="40" y="1170" width="560" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p1-c77" value="&lt;b style='font-size:13px'&gt;Authority boundary (non-negotiable controls)&lt;/b&gt;&lt;br&gt;1. Only people sign / approve / reset, in the UI under SSO; the engine refuses role-less approvals (adlc_governed).&lt;br&gt;2. The flow's engine client exposes read + draft routes only; sign/approve/submit/confirm routes are not in it.&lt;br&gt;3. Claude worker runs with project settings: deny rules + adlc_guard.py hook; drafts as persona &lt;i&gt;claude&lt;/i&gt; (no roles).&lt;br&gt;4. One person, one role per gate; previous gate must be approved (engine) and is re-checked by Spec Kit commands.&lt;br&gt;5. Approved artifacts are frozen in the hash-chained ledger; drift on authority files blocks later gates.&lt;br&gt;6. Evidence is generated by CI / engine actions, never hand-edited; verify-ledger runs before every signature wait.&lt;br&gt;7. Graph state is a cache: every resume re-reads the engine (sync node); events are hints, not decisions.&lt;br&gt;8. lifecycle_flow/, gate profiles and the preset are under CODEOWNERS and change through platform governance." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p1-1">
          <mxGeometry x="620" y="1170" width="900" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p1-c78" value="&lt;b style='font-size:13px'&gt;Human inputs the flow waits for (interrupts)&lt;/b&gt;&lt;br&gt;G0: PO submit, Data owner classification confirm, G0 signatures&lt;br&gt;G1: clarification answers (Business owner), G1 limits/KPI confirmation, signatures&lt;br&gt;G2: Architecture + Security signatures&lt;br&gt;G3: golden / adversarial labels (ground truth is human), PR code-owner review, signatures&lt;br&gt;G4: RAI + Compliance signatures (reject → rework path)&lt;br&gt;G5: CAB change-request decision, signatures&lt;br&gt;G6 / G7: signatures after scheduled hypercare / review windows&lt;br&gt;Timeouts → reminder → escalation to gate owner (SLA per gate)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p1-1">
          <mxGeometry x="1540" y="1170" width="820" height="230" as="geometry" />
        </mxCell>
        <mxCell id="p1-c79" value="&lt;b style='font-size:13px'&gt;Cross-cutting&lt;/b&gt;&lt;br&gt;• Risk-tier gate profiles (YAML): same G0–G7 order, checks/thresholds scale with tier&lt;br&gt;• Many use cases in parallel: engine keyed by use_case + release; one LangGraph thread each&lt;br&gt;• Cost: per-node and per-thread budget for Claude runs; live-model evals only when a gate condition asks&lt;br&gt;• Tracing: lifecycle flow + worker + product agents → OpenTelemetry/OpenInference → Phoenix&lt;br&gt;• Metrics: cycle time per gate, rework count, time waiting on people, cost per release&lt;br&gt;• Evidence pack per release/gate for audit (adlc.py evidence-pack)&lt;br&gt;• Regulatory mapping: gates/checks ↔ EU AI Act, ISO/IEC 42001, NIST AI RMF controls" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p1-1">
          <mxGeometry x="2380" y="1170" width="880" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p2" name="2 · Technology architecture and trust zones">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="p2-0" />
        <mxCell id="p2-1" parent="p2-0" />
        <mxCell id="p2-c1" value="&lt;b style='font-size:22px'&gt;Technology architecture — automation plane vs authority plane&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:12px'&gt;Arrows show calls and events. The automation plane has no route to any decision endpoint.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="10" width="2500" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2-c2" value="&lt;b style='font-size:14px'&gt;People &amp; channels&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="80" width="2520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="p2-c3" value="&lt;b style='font-size:14px'&gt;Automation plane (no authority)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="300" width="1240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p2-c4" value="&lt;b style='font-size:14px'&gt;Authority plane — ADLC engine&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="p2-1">
          <mxGeometry x="1320" y="300" width="1240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p2-c5" value="&lt;b style='font-size:14px'&gt;Delivery (GitHub)&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="p2-1">
          <mxGeometry x="40" y="890" width="1240" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p2-c6" value="&lt;b style='font-size:14px'&gt;Product runtime — the agent being built&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="p2-1">
          <mxGeometry x="1320" y="890" width="760" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p2-c7" value="&lt;b style='font-size:14px'&gt;Observability &amp; on-call&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;opacity=60;" vertex="1" parent="p2-1">
          <mxGeometry x="2110" y="890" width="450" height="560" as="geometry" />
        </mxCell>
        <mxCell id="p2-c8" value="&lt;b&gt;Intake source&lt;/b&gt;&lt;br&gt;Jira / Azure DevOps use-case card&lt;br&gt;(file in intake/ during pilot)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="120" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-c9" value="&lt;b&gt;ADLC UI (Streamlit)&lt;/b&gt;&lt;br&gt;Use Case Intake + ADLC Lifecycle pages&lt;br&gt;SSO; personas → IdP groups → ADLC roles&lt;br&gt;submit · confirm · sign · reject" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="370" y="120" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-c10" value="&lt;b&gt;GitHub PR review&lt;/b&gt;&lt;br&gt;CODEOWNERS, branch protection&lt;br&gt;code-owner approval" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="780" y="120" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-c11" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;Slack / Teams: brief ready, waiting on you, SLA reminders, escalation" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="1110" y="120" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-c12" value="&lt;b&gt;Labelling&lt;/b&gt;&lt;br&gt;golden + adversarial cases labelled by people (ground truth is human)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="1440" y="120" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-c13" value="&lt;b&gt;Signers by gate&lt;/b&gt;&lt;br&gt;G0 Sponsor, Risk, Data owner · G1 Business owner, AI lead · G2 Architecture, Security&lt;br&gt;G3 AI lead, PO · G4 RAI/Risk, Compliance · G5 CAB, Head of business · G6 Head of business · G7 Head of business, AI lead" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="1800" y="120" width="730" height="130" as="geometry" />
        </mxCell>
        <mxCell id="p2-c14" value="&lt;b&gt;LangGraph lifecycle flow&lt;/b&gt; (lifecycle_flow/)&lt;br&gt;StateGraph: one subgraph per gate G0–G7&lt;br&gt;nodes: sync · precheck · author · check · fix-loop · brief · verify-ledger · await (interrupt) · route&lt;br&gt;thread_id = use_case:release · flow_version in state&lt;br&gt;schedules for G6/G7 windows" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="340" width="520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p2-c15" value="&lt;b&gt;Checkpointer&lt;/b&gt;&lt;br&gt;Postgres (LangGraph PostgresSaver)&lt;br&gt;cache only; rebuildable from engine" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="570" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-c16" value="&lt;b&gt;Event relay&lt;/b&gt;&lt;br&gt;consumes engine outbox&lt;br&gt;→ Command(resume) on the thread" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="340" y="570" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p2-c17" value="&lt;b&gt;Engine client (read + draft only)&lt;/b&gt;&lt;br&gt;GET gates, checks, board, ledger/verify · POST drafts as &lt;i&gt;claude&lt;/i&gt; · run actions&lt;br&gt;&lt;font color='#b85450'&gt;no sign / approve / reset / submit / confirm routes&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="70" y="710" width="520" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2-c18" value="&lt;b&gt;Claude Code worker&lt;/b&gt; (Claude Agent SDK, headless)&lt;br&gt;git worktree per thread · branch release/x&lt;br&gt;setting_sources = project → .claude/settings.json deny rules + adlc_guard.py hook&lt;br&gt;budget: max turns / cost per node · tools limited per node" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;verticalAlign=top;align=left;spacingLeft=6;spacingTop=4;" vertex="1" parent="p2-1">
          <mxGeometry x="630" y="340" width="620" height="200" as="geometry" />
        </mxCell>
