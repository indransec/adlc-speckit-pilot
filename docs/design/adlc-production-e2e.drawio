                <mxCell id="p2c130" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#23445d;fontSize=9;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=2;spacingTop=6;spacingRight=6;" value="&lt;b style=&quot;font-size:12px&quot;&gt;KEY CONTROLS&lt;/b&gt;&lt;br&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; style=&quot;border-collapse:collapse;border-color:#9aa9b8;font-size:9px;width:100%;&quot;&gt;&lt;tr&gt;&lt;th style=&quot;background:#23445d;color:#ffffff;text-align:left;padding:3px;&quot;&gt;Control&lt;/th&gt;&lt;th style=&quot;background:#23445d;color:#ffffff;text-align:left;padding:3px;&quot;&gt;Mechanism&lt;/th&gt;&lt;th style=&quot;background:#23445d;color:#ffffff;text-align:left;padding:3px;&quot;&gt;Evidence / metric&lt;/th&gt;&lt;th style=&quot;background:#23445d;color:#ffffff;text-align:left;padding:3px;&quot;&gt;Alert&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;&lt;b&gt;No payment without authority&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;KMS-signed approval token verified in tool gateway (ADR-003)&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;payment_without_token = 0&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Sev1 → page + auto kill switch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;&lt;b&gt;No unevaluated code in prod&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;cosign attestations + Kyverno verifyImages&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;release-record, admission logs&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;Admission denial → Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;&lt;b&gt;Authority limits unchanged&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Deterministic routing.py + CODEOWNERS + CI drift check&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;G1 record, routing drift check&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;PR blocked&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;&lt;b&gt;PII never reaches models unredacted&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;Presidio redaction before LiteLLM&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;pii_leak_count = 0 (evals + span scan)&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;Sev1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;&lt;b&gt;Prompt injection via documents&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Injection filter + read-only model tools&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Injection suite 100%; red-team blocked&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Injection spike → Sev2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;&lt;b&gt;Runaway cost / loops&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;LiteLLM per-key budget · max 40 steps · ≤ USD 0.25 / claim&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;step_and_cost_budget_respected&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;cost_spike → Sev3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;&lt;b&gt;Fairness&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Counterfactual parity per release + monthly&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;parity ≥ 0.95&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#ffffff;&quot;&gt;Reviewed at G7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;&lt;b&gt;Decision-quality drift&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;Phoenix online evals + QA sampling + Evidently&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;Override rate, calibration&lt;/td&gt;&lt;td style=&quot;padding:3px;vertical-align:top;background:#f3f6f9;&quot;&gt;override_rate_high → Sev2&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
